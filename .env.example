# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=""

# APP_URL: Public HTTPS origin of FGOM21. Netlify-hosted sites use this address
# to send anonymous visit totals back to the analytics API. Keep localhost for development.
# Preserve the .data folder on persistent disk so analytics survive restarts.
APP_URL="http://localhost:3000"
# Optional persistent directory for uploaded sites and visit analytics.
# FGOM_HOSTING_DATA_PATH=""

# Optional Cloudflare Workers AI credentials for direct Cloudflare integration
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""

# Netlify personal access token used by the server for customer deployments.
# Copy this template to .env, then add the token there.
# Never put a real token in this example file, use a VITE_ prefix, or expose it in the browser.
NETLIFY_ACCESS_TOKEN=""

# Arcjet Security API Key (Bot Detection, Rate Limiting & Shield)
ARCJET_KEY=""

# Optional Supabase Auth and server-only service role for account and GitHub management.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# 32-byte encryption key (base64 or 64-character hex) for provider credentials.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PLATFORM_CREDENTIALS_ENCRYPTION_KEY=""

# OAuth applications owned by FGOM21 AI. These stay on the server; clients
# authenticate on GitHub, Vercel, or Supabase and never paste their own tokens.
# Register these callback URLs with each provider:
# http://localhost:3000/api/platform/oauth/github/callback
# http://localhost:3000/api/platform/oauth/vercel/callback
# http://localhost:3000/api/platform/oauth/supabase/callback
GITHUB_OAUTH_CLIENT_ID=""
GITHUB_OAUTH_CLIENT_SECRET=""
VERCEL_OAUTH_CLIENT_ID=""
VERCEL_OAUTH_CLIENT_SECRET=""
SUPABASE_OAUTH_CLIENT_ID=""
SUPABASE_OAUTH_CLIENT_SECRET=""